cmake_minimum_required(VERSION 3.20)
if(NOT license_output OR NOT tools_source OR NOT shared_prefixes)
    message(FATAL_ERROR "Workbench license staging needs its selected SDK prefixes")
endif()
file(MAKE_DIRECTORY "${license_output}")
file(LOCK "${license_output}/.stage.lock" GUARD PROCESS TIMEOUT 120)
foreach(component ariatools aria json mira openssl)
    file(REMOVE_RECURSE "${license_output}/${component}")
endforeach()
file(MAKE_DIRECTORY "${license_output}/ariatools")
foreach(document LICENSE THIRD_PARTY_NOTICES.md)
    configure_file("${tools_source}/${document}" "${license_output}/ariatools/${document}" COPYONLY)
endforeach()
foreach(prefix IN LISTS shared_prefixes)
    if(NOT IS_DIRECTORY "${prefix}/share/licenses")
        message(FATAL_ERROR "Missing selected SDK license materials: ${prefix}")
    endif()
    file(COPY "${prefix}/share/licenses/" DESTINATION "${license_output}")
endforeach()
